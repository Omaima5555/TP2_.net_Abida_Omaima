@model GestionArticles.Models.Category

@{
    ViewData["Title"] = "Détails de la catégorie";
}

<div class="container mt-4" style="max-width:700px">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">🗂️ Détails de la catégorie</h4>
        </div>

        <div class="card-body">

            <dl class="row mb-3">
                <dt class="col-sm-4">Numéro</dt>
                <dd class="col-sm-8">@Model.CategoryId</dd>

                <dt class="col-sm-4">Nom</dt>
                <dd class="col-sm-8"><strong>@Model.CategoryName</strong></dd>

                <dt class="col-sm-4">Nombre de produits</dt>
                <dd class="col-sm-8">
                    @if (Model.Products != null)
                    {
                        <span class="badge rounded-pill bg-primary">@Model.Products.Count</span>
                    }
                    else
                    {
                        <span class="text-muted">–</span>
                    }
                </dd>
            </dl>

            <h6>Produits de cette catégorie</h6>
            @if (Model.Products != null && Model.Products.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var p in Model.Products)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @p.Name
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId"
                               class="btn btn-sm btn-outline-primary">Voir</a>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">
                    Aucun produit à afficher ici.
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId">Voir les produits de cette catégorie</a>
                </p>
            }

        </div>

        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">← Retour à la liste</a>
            <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-warning">✏️ Modifier</a>
        </div>
    </div>

</div>
