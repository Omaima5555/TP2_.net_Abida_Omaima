@model GestionArticles.Models.Category

@{
    ViewData["Title"] = "Modifier la catégorie";
}

<div class="container mt-4" style="max-width:600px">

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h4 class="mb-0">✏️ Modifier la catégorie</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="CategoryId" />

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label fw-semibold">Nom de la catégorie</label>
                    <input asp-for="CategoryName" class="form-control" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">← Retour à la liste</a>
                    <button type="submit" class="btn btn-warning">💾 Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
