@model GestionArticles.Models.Category

@{
    ViewData["Title"] = "Supprimer la catégorie";
}

<div class="container mt-4" style="max-width:600px">

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">🗑️ Supprimer la catégorie</h4>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                ⚠️ Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est définitive.
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-4">Nom</dt>
                <dd class="col-sm-8"><strong>@Model.CategoryName</strong></dd>

                <dt class="col-sm-4">Produits liés</dt>
                <dd class="col-sm-8">
                    @if (Model.Products != null)
                    {
                        <span class="badge rounded-pill bg-primary">@Model.Products.Count</span>
                    }
                    else
                    {
                        <span class="text-muted">–</span>
                    }
                </dd>
            </dl>

            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="alert alert-danger mt-3 mb-0">
                    Cette catégorie contient des produits : la suppression peut être refusée ou supprimer aussi ces produits.
                </div>
            }
        </div>

        <div class="card-footer">
            <form asp-action="Delete" class="d-flex justify-content-between">
                <input type="hidden" asp-for="CategoryId" />
                <a asp-action="Index" class="btn btn-outline-secondary">← Annuler</a>
                <button type="submit" class="btn btn-danger">🗑️ Oui, supprimer</button>
            </form>
        </div>
    </div>

</div>
