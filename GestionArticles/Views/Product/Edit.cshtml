@model GestionArticles.ViewModels.EditViewModel

@{
    ViewData["Title"] = "Modifier le produit";
    // Chemin de la photo actuelle du produit
    var photoPath = "~/images/" + (Model.ExistingImagePath ?? "noimage.jpg");
}

<div class="container mt-4" style="max-width:750px">

    <div class="card shadow-sm">
        <div class="card-header bg-warning">
            <h4 class="mb-0">✏️ Modifier le produit</h4>
        </div>

        <div class="card-body">
            <form asp-controller="Product" asp-action="Edit" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                @* Champs cachés nécessaires à la mise à jour en base *@
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="ExistingImagePath" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Nom du produit</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold">Prix (TND)</label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="QteStock" class="form-label fw-semibold">Quantité en stock</label>
                        <input asp-for="QteStock" class="form-control" />
                        <span asp-validation-for="QteStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Catégorie</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PromoPercent" class="form-label fw-semibold">Promotion (%)</label>
                        <div class="input-group">
                            <input asp-for="PromoPercent" class="form-control" min="0" max="90" />
                            <span class="input-group-text">%</span>
                        </div>
                        <small class="text-muted">0 = pas de promotion</small>
                        <span asp-validation-for="PromoPercent" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImagePath" class="form-label fw-semibold">Changer la photo</label>
                    <input asp-for="ImagePath" class="form-control" accept="image/*" />
                    <small class="text-muted">Laissez vide pour garder la photo actuelle.</small>
                </div>

                @* Photo actuelle / aperçu de la nouvelle photo *@
                <div class="text-center mb-3">
                    <img id="imageEmp" src="@photoPath" asp-append-version="true"
                         class="img-thumbnail" style="height:140px" alt="Photo du produit" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" asp-controller="Product" class="btn btn-outline-secondary">← Annuler</a>
                    <button type="submit" class="btn btn-warning">💾 Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Aperçu de la nouvelle photo choisie
        document.getElementById('ImagePath').addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imageEmp').src = e.target.result;
            };
            reader.readAsDataURL(file);
        });
    </script>
}
