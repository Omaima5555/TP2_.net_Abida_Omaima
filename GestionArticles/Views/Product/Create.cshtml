@model GestionArticles.ViewModels.CreateViewModel

@{
    ViewData["Title"] = "Nouveau produit";
}

<div class="container mt-4" style="max-width:750px">

    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">➕ Nouveau produit</h4>
        </div>

        <div class="card-body">
            @* enctype obligatoire pour l'envoi de fichier *@
            <form enctype="multipart/form-data" asp-action="Create">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Nom du produit</label>
                    <input asp-for="Name" class="form-control" placeholder="Ex : Chocolat Maestro" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold">Prix (TND)</label>
                        <input asp-for="Price" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="QteStock" class="form-label fw-semibold">Quantité en stock</label>
                        <input asp-for="QteStock" class="form-control" />
                        <span asp-validation-for="QteStock" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Catégorie</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PromoPercent" class="form-label fw-semibold">Promotion (%)</label>
                        <div class="input-group">
                            <input asp-for="PromoPercent" class="form-control" min="0" max="90" />
                            <span class="input-group-text">%</span>
                        </div>
                        <small class="text-muted">0 = pas de promotion</small>
                        <span asp-validation-for="PromoPercent" class="text-danger"></span>
                    </div>
                </div>

                @* ImagePath est de type IFormFile : génère un <input type="file"> *@
                <div class="mb-3">
                    <label asp-for="ImagePath" class="form-label fw-semibold">Image du produit</label>
                    <input asp-for="ImagePath" class="form-control" accept="image/*" />
                    <img id="preview" class="img-thumbnail mt-2 d-none" style="height:140px" alt="Aperçu" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">← Retour à la liste</a>
                    <button type="submit" class="btn btn-success">✔ Créer le produit</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Aperçu de l'image choisie
        document.getElementById('ImagePath').addEventListener('change', function () {
            const img = document.getElementById('preview');
            const file = this.files[0];
            if (!file) { img.classList.add('d-none'); return; }
            const reader = new FileReader();
            reader.onload = function (e) {
                img.src = e.target.result;
                img.classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        });
    </script>
}
