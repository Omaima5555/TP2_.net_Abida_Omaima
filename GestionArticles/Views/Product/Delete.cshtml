@model GestionArticles.Models.Product

@{
    ViewData["Title"] = "Supprimer le produit";
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
}

<div class="container mt-4" style="max-width:700px">

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">🗑️ Supprimer le produit</h4>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                ⚠️ Êtes-vous sûr de vouloir supprimer ce produit ? Cette action est définitive.
            </div>

            <div class="row g-3 align-items-center">
                <div class="col-md-4 text-center">
                    <img src="@photoPath" asp-append-version="true" class="img-thumbnail"
                         style="height:150px; object-fit:cover" alt="@Model.Name" />
                </div>

                <div class="col-md-8">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Nom</dt>
                        <dd class="col-sm-8"><strong>@Model.Name</strong></dd>

                        <dt class="col-sm-4">Prix</dt>
                        <dd class="col-sm-8">
                            @Model.Price.ToString("0.00") TND
                            @if (Model.PromoPercent > 0)
                            {
                                <span class="badge bg-danger">-@Model.PromoPercent%</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Stock</dt>
                        <dd class="col-sm-8">@Model.QteStock</dd>

                        <dt class="col-sm-4">Catégorie</dt>
                        <dd class="col-sm-8">
                            @if (Model.Category != null)
                            {
                                @Model.Category.CategoryName
                            }
                            else
                            {
                                <span class="text-muted">N° @Model.CategoryId</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <form asp-action="Delete" class="d-flex justify-content-between">
                <input type="hidden" asp-for="ProductId" />
                <a asp-action="Index" class="btn btn-outline-secondary">← Annuler</a>
                <button type="submit" class="btn btn-danger">🗑️ Oui, supprimer</button>
            </form>
        </div>
    </div>

</div>
