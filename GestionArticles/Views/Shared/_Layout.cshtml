@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GestionArticles</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GestionArticles.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Bouton afficher / cacher le menu latéral des catégories -->
                <button class="btn btn-outline-primary" type="button">
                    <img src="~/images/categorie.jpg"
                         alt="Ouvrir la liste des catégories"
                         id="toggleMenu"
                         style="width:30px;height:30px" />
                </button>

                <!-- Logo / Nom du site -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Gestion des Articles
                </a>

                <!-- Bouton mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menu principal -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- Administration (visible seulement pour le rôle Admin) -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   data-bs-toggle="dropdown"
                                   href="#"
                                   role="button"
                                   aria-haspopup="true"
                                   aria-expanded="false">
                                    Administration
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="CreateRole">
                                        Create Role
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item"
                                       asp-controller="Admin"
                                       asp-action="ListRoles">
                                        List Roles
                                    </a>
                                </div>
                            </li>
                        }

                        <!-- Liste d'articles (dropdown) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               data-bs-toggle="dropdown"
                               href="#"
                               role="button"
                               aria-haspopup="true"
                               aria-expanded="false">
                                Liste d'articles
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item"
                                   asp-controller="Product"
                                   asp-action="Index">
                                    Produits
                                </a>
                                <a class="dropdown-item"
                                   asp-controller="Category"
                                   asp-action="Index">
                                    Catégories
                                </a>
                            </div>
                        </li>
                        <li class="nav-item">

                        <a class="nav-link text-dark" asp-controller="Panier" asp-action="Index">Mon Panier</a>

                         </li>

                    </ul>

                    <!-- Recherche -->
                    <form class="d-flex"
                          asp-area=""
                          asp-controller="Product"
                          asp-action="Search">
                        <input class="form-control me-sm-2"
                               type="search"
                               placeholder="Search"
                               name="val" />
                        <button class="btn btn-secondary my-2 my-sm-0"
                                type="submit">
                            Search
                        </button>
                    </form>

                    <!-- Menu Identity (Login / Register / Logout) -->
                    <ul class="navbar-nav ms-auto">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <form method="post"
                                      asp-controller="Account"
                                      asp-action="Logout">
                                    <button type="submit"
                                            style="width:auto"
                                            class="nav-link btn btn-link py-0">
                                        Logout @User.Identity?.Name
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- Menu latéral + contenu principal -->
    <div class="container-fluid">
        <div class="row">

            <!-- Menu latéral pour les catégories -->
            <div class="col-md-2" id="sidebar" style="display: none;">
                <p> </p>
                <ul class="list-group">
                    @await Html.PartialAsync("_CategoriesMenu", ViewData["Categories"])
                </ul>
            </div>

            <!-- Contenu principal -->
            <div class="col-md-12" id="mainContent">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GestionArticles -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/CustomScript.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>