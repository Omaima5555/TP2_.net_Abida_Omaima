@{
    ViewBag.Title = "Mon panier";
}

<style>
    .cart-wrapper { max-width: 1000px; margin: 0 auto; }
    .cart-card { border: 0; border-radius: 14px; box-shadow: 0 4px 16px rgba(0,0,0,.08); margin-bottom: 1.2rem; transition: .2s; }
    .cart-card:hover { box-shadow: 0 6px 22px rgba(0,0,0,.12); }
    .cart-img { width: 160px; height: 160px; object-fit: contain; border-radius: 10px; background: #f8f9fa; padding: 6px; }
    .qty-btn img { width: 38px; height: 38px; transition: transform .15s; }
    .qty-btn:hover img { transform: scale(1.15); }
    .qty-badge { font-size: 1.1rem; min-width: 2.4rem; }
    .line-total { font-size: 1.15rem; font-weight: 700; color: #198754; }
    .summary-card { border: 0; border-radius: 14px; box-shadow: 0 4px 16px rgba(0,0,0,.08); background: #f8f9fa; }
    .summary-total { font-size: 1.5rem; font-weight: 700; color: #198754; }
    .empty-cart img { opacity: .85; }
</style>

<div class="cart-wrapper">

    <h2 class="mb-4">🛒 Mon panier</h2>

    @if (ViewBag.Liste.Count > 0)
    {
        <div class="row g-4">

            <!-- Liste des articles -->
            <div class="col-lg-8">
                @foreach (var item in ViewBag.Liste)
                {
                    <div class="card cart-card" id="row-@item.Prod.ProductId">
                        <div class="card-body">
                            <div class="row align-items-center">

                                <div class="col-md-4 text-center mb-3 mb-md-0">
                                    <img class="cart-img" src="~/images/@item.Prod.Image" alt="@item.Prod.Name" />
                                </div>

                                <div class="col-md-8">
                                    <h5 class="mb-1">@item.Prod.Name</h5>
                                    <span class="badge bg-info text-dark mb-3">🏷️ @item.Prod.Category.CategoryName</span>

                                    <div class="d-flex align-items-center gap-2 mb-3">
                                        <a href="#" class="MinProducts qty-btn" data-id="@item.Prod.ProductId" title="Diminuer">
                                            <img src="~/images/moin.png" alt="Moins" />
                                        </a>
                                        <span class="badge bg-secondary qty-badge" id="quantite_@item.Prod.ProductId">@item.quantite</span>
                                        <a href="#" class="PlusProducts qty-btn" data-id="@item.Prod.ProductId" title="Augmenter">
                                            <img src="~/images/add.png" alt="Plus" />
                                        </a>
                                        <a href="#" class="RemoveLink qty-btn ms-3" data-id="@item.Prod.ProductId" title="Supprimer">
                                            <img src="~/images/delet.png" alt="Supprimer" />
                                        </a>
                                    </div>

                                    <div class="text-muted">
                                        Prix de <span id="rquantite_@item.Prod.ProductId">@item.quantite</span> article(s) :
                                        <span class="line-total" id="total_@item.Prod.ProductId">@item.TotalPrice</span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Récapitulatif -->
            <div class="col-lg-4">
                <div class="card summary-card">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Récapitulatif</h5>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span>Prix total à payer :</span>
                            <span class="summary-total" id="totalapayer">@ViewBag.total</span>
                        </div>

                        @if (ViewBag.total > 0)
                        {
                            <a href="~/Panier/Checkout" class="btn btn-success btn-lg w-100 mb-2" role="button">Commander »</a>
                        }
                        <a href="~/Product/Index" class="btn btn-outline-secondary w-100" role="button">← Continuer mes achats</a>
                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <div class="text-center mt-5 empty-cart">
            <img src="~/images/panier_vide.png" alt="Panier vide" style="width:200px;height:auto;" />
            <h3 class="mt-3 text-muted">Votre panier est vide !</h3>
            <p class="text-muted">Partez à la découverte de nos produits et faites-vous plaisir 😊</p>
            <a href="~/Product/Index" class="btn btn-primary btn-lg mt-3">🛍️ Voir les produits</a>
        </div>
    }

</div>

<script src="~/js/Monscript.js" type="text/javascript"></script>